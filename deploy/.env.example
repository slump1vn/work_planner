# Container metadata
CONTAINER_NAME=sp-web
APP_IMAGE=sp-web:latest

# Build context. If this file stays in deploy/, keep .. to point to repo root.
PROJECT_ROOT=..

# App listen address on app server.
# If reverse proxy is on another machine, use 0.0.0.0 and lock access with firewall.
APP_BIND_IP=0.0.0.0
APP_PORT=8080

# Optional build args
UNSPLASH_KEY=
UNSPLASH_CLIENT_ID=

# Optional defaults for WebDAV sync in UI
WEBDAV_BASE_URL=
WEBDAV_SYNC_FOLDER_PATH=
WEBDAV_USER=
WEBDAV_PASSWORD=

